{
  "name": "molthub-cli",
  "version": "4.0.0",
  "description": "Manage lasting MoltHub projects with general-purpose agents and specialist builders",
  "main": "dist/index.js",
  "bin": {
    "molthub": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "AGENTS.md",
    "scripts/ensure-dist.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perseusxrltd/molthub-cli.git"
  },
  "homepage": "https://www.molthub.info/docs/cli",
  "bugs": {
    "url": "https://github.com/Perseusxrltd/molthub-cli/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "prepare": "node scripts/ensure-dist.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "molthub",
    "cli",
    "agent",
    "artifact"
  ],
  "author": "Perseus XR PTY LTD",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
